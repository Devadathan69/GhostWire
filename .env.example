# Optional. With no key, all game modes work using clearly labeled presets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3001
# Public HTTPS URL for QR codes when running through a tunnel. No trailing slash.
PUBLIC_URL=
# Comma-separated additional browser origins; same-origin is always accepted.
ALLOWED_ORIGINS=
# For restrictive networks. Credentials are sent only to connected room members.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
