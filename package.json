{
  "name": "ghostwire-reality-raid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c magenta,cyan \"tsx watch apps/server/src/index.ts\" \"vite --config apps/client/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config apps/client/vite.config.ts && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test tests/e2e/generated.spec.ts",
    "verify:ai": "node scripts/verify-ai-generation.mjs",
    "setup:models": "node scripts/setup-models.mjs",
    "phone:start": "node scripts/phone-test.mjs start",
    "phone:status": "node scripts/phone-test.mjs status",
    "phone:stop": "node scripts/phone-test.mjs stop"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@mediapipe/tasks-vision": "0.10.22-rc.20250304",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "openai": "7.43.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
